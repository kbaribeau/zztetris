{
  "name": "zztetris-regression",
  "private": true,
  "description": "Browser-free behavioral checks for the static ZZTetris pages",
  "scripts": {
    "test": "node scripts/test.cjs",
    "sim:st": "node scripts/simulate-st.cjs",
    "minos:st": "node scripts/analyze-st-minos.cjs",
    "left-shapes:st": "node scripts/analyze-st-left-shapes.cjs",
    "review:st": "node scripts/build-st-review-packet.cjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged --hide-all --diff-filter=ACMRT"
  },
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@sinonjs/fake-timers": "15.4.0",
    "husky": "9.1.7",
    "jquery": "3.6.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1"
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  }
}
